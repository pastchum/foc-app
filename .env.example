# ─────────────────────────────────────────────────────────────
# FoC — Friend on Campus · Environment configuration (EXAMPLE)
# ─────────────────────────────────────────────────────────────
# Copy to `.env` and adjust:   cp .env.example .env
#
# `.env` is git-ignored — NEVER commit real secrets.
# Every variable a service reads MUST appear here with a safe
# placeholder, so a teammate knows what to set (PL-NFR2.1.1).
#
# A missing required variable stops the service at boot with the
# variable named — it will not start with an insecure default.
#
# The values below are LOCAL DEVELOPMENT ONLY. Nothing here is a
# real credential and nothing here may be reused off a laptop.
# ─────────────────────────────────────────────────────────────

# ---- Shared by every service --------------------------------
# NODE_ENV   development | test | production
# LOG_LEVEL  fatal | error | warn | info | debug | trace | silent
NODE_ENV=development
LOG_LEVEL=info

# Browser origins allowed to call the services, comma-separated.
# Never set this to `*` — these endpoints carry credentials.
CORS_ORIGINS=http://localhost:3000

# ---- Host ports ---------------------------------------------
# Change any of these if something already holds the port. The
# ports INSIDE the containers never change.
WEB_APP_PORT=3000
USER_SERVICE_PORT=3001
SUPPLIER_SERVICE_PORT=3002
ORDER_SERVICE_PORT=3003
CREDIT_SERVICE_PORT=3004

# Deliberately not 5432/5672: a locally installed Postgres or
# RabbitMQ usually holds those, and `docker compose up` would
# fail to bind.
POSTGRES_PORT=55432
RABBITMQ_PORT=55672
RABBITMQ_MANAGEMENT_PORT=15672

# ---- Postgres -----------------------------------------------
# One server hosting one database and one role per service; see
# postgres-init.sql. These are the superuser credentials used to
# create them, not the per-service ones.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev

# ---- RabbitMQ -----------------------------------------------
RABBITMQ_USER=foc
RABBITMQ_PASSWORD=foc_dev

# ---- User Service (USR-01) ----------------------------------
# Registration is limited to these email domains, comma-separated.
ALLOWED_EMAIL_DOMAINS=u.nus.edu,nus.edu.sg

# Credentials other services send as `X-Service-Key` to call the User
# Service's /internal/** endpoints. Comma-separated, one per caller, each
# at least 16 characters. This value is a LOCAL DEVELOPMENT placeholder.
INTERNAL_SERVICE_KEYS=dev-only-internal-service-key-change-me

# Bootstrap administrators, created on first boot (comma-separated), with a
# shared bootstrap password. An address that already has an account is
# skipped, never promoted. These are LOCAL DEVELOPMENT placeholders: in
# production put the password in the secret store, and change it — there is
# no change-password endpoint yet.
ADMIN_SEED_EMAILS=admin@u.nus.edu
ADMIN_SEED_PASSWORD=dev-only-admin-password-change-me

# Signs access tokens: base64 of an Ed25519 private key (PKCS#8 PEM).
# Optional in development (a throwaway key is generated at boot, so every
# restart logs users out). REQUIRED in production. Generate one with:
#   node -e "const {generateKeyPairSync:g}=require('crypto');console.log(Buffer.from(g('ed25519').privateKey.export({type:'pkcs8',format:'pem'})).toString('base64'))"
# JWT_PRIVATE_KEY=

# Hours an emailed activation link stays valid (default 24, max 168).
# ACTIVATION_TOKEN_TTL_HOURS=24

# ---- Supplier Service (SUP-01) ------------------------------
# The Supplier Service verifies callers by asking the User Service who is
# behind a token (@foc/auth-client). It presents this key as `X-Service-Key`;
# it MUST be one of the User Service's INTERNAL_SERVICE_KEYS above. Defaults to
# the shared dev key so a fresh clone works; give it its own key in production.
SUPPLIER_INTERNAL_KEY=dev-only-internal-service-key-change-me
# USER_SERVICE_URL is injected per container by compose.yaml
# (http://user-service:3001). Under Compose, SUPPLIER_INTERNAL_KEY above is
# mapped to the INTERNAL_SERVICE_KEY the service actually reads. For a direct
# (non-Compose) run, set the two names the service reads itself, or boot fails
# naming them:
# USER_SERVICE_URL=http://localhost:3001
# INTERNAL_SERVICE_KEY=dev-only-internal-service-key-change-me

# ---- Supplied by Compose, not set here ----------------------
# SERVICE_NAME, PORT, DATABASE_URL and RABBITMQ_URL are injected
# per container by compose.yaml. Set them yourself only when
# running a service directly outside Compose:
#
#   SERVICE_NAME=user-service
#   PORT=3001
#
# DATABASE_URL is read by the User Service (USR-01); SUP-01 will
# read it too.
#
# RABBITMQ_URL *is* read, by user-service and credit-service. It
# is optional: a service without it still boots and simply does
# not publish or consume, so `npm run dev:user` works with no
# broker running. Compose always supplies it.

# ---- Added by later tickets ---------------------------------
# USR-02 adds the JWT signing key. Add variables here in the
# ticket that introduces them, never before.
