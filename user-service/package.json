{
  "name": "@foc/user-service",
  "version": "0.1.0",
  "private": true,
  "description": "FoC User Service — identity, authentication, RBAC",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "cross-env SERVICE_NAME=user-service PORT=3001 tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@foc/platform": "*",
    "@nestjs/common": "^12.0.3",
    "@nestjs/core": "^12.0.3",
    "@nestjs/platform-express": "^12.0.3",
    "@node-rs/argon2": "^2.2.1",
    "drizzle-orm": "^0.45.3",
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@nestjs/testing": "^12.0.3",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "cross-env": "^10.0.0",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.2.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.1"
  },
  "type": "module"
}
